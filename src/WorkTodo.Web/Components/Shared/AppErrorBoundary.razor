@using Microsoft.Extensions.Logging
@inherits ErrorBoundaryBase
@inject ILogger<AppErrorBoundary> Logger

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div class="alert alert-danger" role="alert">
        <h2 class="h5">Something went wrong</h2>
        <p class="mb-2">An unexpected error occurred. Your latest change may not have been saved.</p>
        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="Recover">Try again</button>
    </div>
}

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "Unhandled exception in a page");
        return Task.CompletedTask;
    }
}
